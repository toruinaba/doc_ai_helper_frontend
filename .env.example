# ===========================================
# Document AI Helper Frontend Configuration
# ===========================================
# Copy this file to .env and configure as needed
# Most settings have sensible defaults and only need to be set for specific requirements

# ===========================================
# Essential Configuration
# ===========================================
# Backend API base URL (REQUIRED)
VITE_API_BASE_URL=http://localhost:8000

# Backend URL for link transformations (usually same as API base URL)
VITE_BACKEND_URL=http://localhost:8000

# Use mock API for development/testing
VITE_USE_MOCK_API=false

# ===========================================
# Optional Repository Defaults
# ===========================================
# Only needed if you want to change the default repository settings
# VITE_DEFAULT_SERVICE=github
# VITE_DEFAULT_OWNER=your-organization
# VITE_DEFAULT_REPO=your-docs-repo
# VITE_DEFAULT_REF=main
# VITE_DEFAULT_PATH=README.md

# ===========================================
# Optional LLM Configuration
# ===========================================
# Only needed if you want to override defaults
# VITE_LLM_DEFAULT_PROVIDER=openai
# VITE_LLM_DEFAULT_TOOL_CHOICE=auto
# VITE_LLM_SYSTEM_PROMPT_TEMPLATE=contextual_document_assistant_ja

# ===========================================
# Optional MCP Tools Configuration
# ===========================================
# Only needed if you want to disable MCP tools or use custom tools
# VITE_MCP_TOOLS_ENABLED=true
# VITE_MCP_DEFAULT_EXECUTION_MODE=auto
# VITE_MCP_AVAILABLE_TOOLS=tool1,tool2,tool3
# VITE_MCP_TOOL_DESCRIPTIONS=tool1:説明1,tool2:説明2

# ===========================================
# Optional Link Processing Configuration (責任分界アプローチ)
# ===========================================
# Link processing mode: legacy (default), selective, hybrid
# VITE_LINK_PROCESSING_MODE=legacy

# Transform links mode for backend: 'true' (images CDN only due to backend change), 'false' (no transform)
# VITE_TRANSFORM_LINKS_MODE=true

# Enable CDN optimization for images (default: true)
# VITE_ENABLE_CDN_OPTIMIZATION=true

# Enable experimental features (default: false)
# VITE_ENABLE_EXPERIMENTAL_FEATURES=false

# Enable fallback to legacy mode on errors (default: true)
# VITE_ENABLE_LINK_PROCESSING_FALLBACK=true

# Enable debug mode for link processing (default: false)
# VITE_LINK_PROCESSING_DEBUG=false

# ===========================================
# Optional UI Control
# ===========================================
# Only needed if you want to hide specific UI elements (all default to true)
# VITE_SHOW_DEBUG_PANEL=false
# VITE_SHOW_DOCUMENT_CONTEXT_PANEL=false

# ===========================================
# Example Production Configuration
# ===========================================
# VITE_API_BASE_URL=https://your-api-domain.com
# VITE_BACKEND_URL=https://your-api-domain.com
# VITE_USE_MOCK_API=false
# VITE_SHOW_DEBUG_PANEL=false